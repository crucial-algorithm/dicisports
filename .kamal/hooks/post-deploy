#!/bin/bash
set -e

echo "🔍 Post-deploy verification starting..."

# Function to verify database schema is up to date
verify_migrations() {
    echo "🔄 Verifying database schema is up to date..."
    local max_attempts=3
    local attempt=1
    
    while [ $attempt -le $max_attempts ]; do
        echo "Verification attempt $attempt/$max_attempts"
        
        # Check if database schema matches migrations
        if kamal app exec -d htz --reuse "npx prisma migrate status" | grep -q "Database schema is up to date"; then
            echo "✅ Database schema verification successful"
            return 0
        fi
        
        echo "⚠️ Schema verification attempt $attempt failed, retrying in 3 seconds..."
        sleep 3
        attempt=$((attempt + 1))
    done
    
    echo "❌ Database schema verification failed after $max_attempts attempts"
    echo "🔧 Attempting to fix by running migrations..."
    
    # Try to fix by running migrations
    if kamal app exec -d htz --reuse "npx prisma migrate deploy"; then
        echo "✅ Recovery migration completed successfully"
        return 0
    else
        echo "❌ Recovery migration failed"
        return 1
    fi
}

# Function to verify application health
verify_app_health() {
    echo "🏥 Checking application health..."
    local max_attempts=10
    local attempt=1
    
    while [ $attempt -le $max_attempts ]; do
        echo "Health check attempt $attempt/$max_attempts"
        
        # Check if the app responds to health check
        if kamal app exec -d htz --reuse "curl -f http://localhost:3000/ping" 2>/dev/null; then
            echo "✅ Application health check passed"
            return 0
        fi
        
        echo "⚠️ Health check attempt $attempt failed, waiting 5 seconds..."
        sleep 5
        attempt=$((attempt + 1))
    done
    
    echo "❌ Application health check failed after $max_attempts attempts"
    return 1
}

echo "📍 Running post-deploy verification on: $KAMAL_DESTINATION"

# Verify migrations
if ! verify_migrations; then
    echo "❌ Migration verification failed"
    exit 1
fi

# Verify app health
if ! verify_app_health; then
    echo "❌ Application health verification failed"
    exit 1
fi

echo "✅ Post-deploy verification completed successfully"
echo "🎉 Deployment to $KAMAL_DESTINATION is healthy and ready"
