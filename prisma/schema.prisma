// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Commands to know:
// `npx prisma generate` - update TypeScript definitions based on this schema
// `npx prisma db push` - push the schema changes to the database
// `npx prisma studio` - open the Studio, which allows you to edit the schema.
// `npx prisma migrate reset` - reset the migrations to the last version. This will reset the DB and run the seed script
// `npx prisma migrate dev --name <descriptive-name>` - generate a migration file for any changes you make to the schema (this will be committed).
// `npx prisma migrate dev --name <descriptive-name> --create-only` - generate migration script... example: npx prisma migrate dev --name login_with_password --create-only


// Currency handling: Integer * 1000

// Partial types: https://www.prisma.io/docs/concepts/components/prisma-client/advanced-type-safety/operating-against-partial-structures-of-model-types

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  ORGANIZER
  ORGANIZER_WANNABE
}

model User {
  id           String          @id
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  email        String          @unique
  password     String?
  salt         String?
  lat          Float?
  lng          Float?
  location     String?
  name         String
  role         Role            @default(MEMBER)
  sessions     Session[]
  groups       Group[]
  favGroups    FavoriteGroup[]
  events       Event[]
  favEvents    FavoriteEvent[]
  organizer    Organizer?
  DiscountCode DiscountCode[]

  @@map("users")
}

model Session {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  expirationDate DateTime @map("expiration_date")

  @@map("sessions")
}

model Sport {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  name      Json
  picture   String
  events    Event[]
  groups    Group[]

  @@map("sports")
}

model Difficulty {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  name          Json
  description   Json
  events        Event[]

  @@map("difficulties")
}

enum Status {
  auto
  draft
  published
  unpublished
  deleted
}

model Event {
  id                    String      @id @default(uuid())
  name                  String?
  slug                  String?     @unique
  sport                 Sport?      @relation(fields: [sportId], references: [id])
  sportId               Int?        @map("sport_id")
  difficulty            Difficulty? @relation(fields: [difficultyId], references: [id])
  difficultyId          Int?        @map("difficulty_id")
  startAt               DateTime?   @map("start_at")
  endAt                 DateTime?   @map("end_at")
  lat                   Float?
  lng                   Float?
  location              Json?
  placeName             String?     @map("place_name")
  useExternalBooking    Boolean     @default(false) @map("use_external_booking")
  externalBookingUrl    String?     @map("external_booking_url")
  description           String?
  status                Status      @default(auto)
  image1                String?
  image2                String?
  image3                String?
  image4                String?
  image5                String?
  directions            String?
  regulationPath        String?     @map("regulation_path")
  regulationContent     String?     @map("regulation_content")
  regulationFileName    String?     @map("regulation_file_name")
  bibStartingNumber     Int?        @map("bib_starting_number") @default(1)
  createdBy             User        @relation(fields: [createdById], references: [id])
  createdById           String      @map("created_by")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  hideFromLatestEvents  Boolean     @default(false) @map("hide_from_latest_events")
  externalWebsite       String?     @map("external_website")
  documents             Document[]
  perks                 Perk[]
  races                 Race[]
  bookings              Booking[]
  teams                 EventTeam[]
  latestBibNumber       LatestBibNumber?
  raceParticipant       RaceParticipant[]

  favEvents FavoriteEvent[]

  @@map("events")
}

model Document {
  id        String   @id @default(uuid())
  path      String?
  fileName  String?  @map("file_name")
  type      String?
  position  Int      @default(autoincrement())
  label     String?
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  status    Status   @default(auto)

  @@map("documents")
}

// Groups start
model Group {
  id            String          @id
  name          String?
  slug          String?         @unique
  sport         Sport?          @relation(fields: [sportId], references: [id])
  sportId       Int?            @map("sport_id")
  groupType     GroupType       @relation(fields: [groupTypeId], references: [id])
  groupTypeId   Int             @map("group_type_id")
  groupSpirit   GroupSpirit     @relation(fields: [groupSpiritId], references: [id])
  groupSpiritId Int             @map("group_spirit_id")
  lat           Float
  lng           Float
  location      String?
  near          String?
  dayOfWeek     Int             @map("day_of_week") // 0 Monday, 6 Sunday
  timeOfDay     Int             @map("time_of_day")
  whatsapp      String?
  image1        String?
  image2        String?
  image3        String?
  description   String?
  status        Status          @default(auto)
  createdAt     DateTime        @default(now()) @map("created_at")
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdById   String          @map("created_by")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  schedules     GroupSchedule[]

  favGroups FavoriteGroup[]

  @@map("groups")
}

model GroupType {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  name      Json
  groups    Group[]

  @@map("groups_type")
}

model GroupSpirit {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  name      Json
  groups    Group[]

  @@map("groups_spirit")
}

model FavoriteGroup {
  userId    String   @map("user_id")
  groupId   String   @map("group_id")
  user      User     @relation(fields: [userId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, groupId])
  @@map("favorite_groups")
}

model Perk {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  isDefault    Boolean @default(false) @map("is_default")
  isEnabled    Boolean @default(false) @map("is_enabled")
  displayOrder Int     @default(autoincrement()) @map("display_order")
  eventId      String  @map("event_id")
  event        Event   @relation(fields: [eventId], references: [id])

  @@map("perks")
}

model Race {
  id              String            @id @default(uuid())
  name            String
  distance        Float
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  startTime       Int               @map("start_time")
  elevationGain   Int               @map("elevation_gain")
  elevationLoss   Int?              @map("elevation_loss")
  price           Int
  priceEarlyBird  Int?              @map("price_early_bird")
  validUntil      DateTime?         @map("valid_until")
  raceDescription String?           @map("race_description")
  displayOrder    Int               @default(autoincrement()) @map("display_order")
  status          Status            @default(auto)
  track           String?
  eventId         String            @map("event_id")
  event           Event             @relation(fields: [eventId], references: [id])
  raceParticipant RaceParticipant[]

  @@map("races")
}

model GroupSchedule {
  id        String @id @default(uuid())
  dayOfWeek Int    @map("day_of_week")
  timeOfDay Int    @map("time_of_day")
  groupId   String @map("group_id")
  group     Group  @relation(fields: [groupId], references: [id])

  @@map("group_schedule")
}

model FavoriteEvent {
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, eventId])
  @@map("favorite_events")
}

enum ParticipantStatus {
  auto
  saved
}

model Participant {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  firstName        String?           @map("first_name")
  lastName         String?           @map("last_name")
  gender           String?           @db.Char(1)
  birthdate        DateTime?
  phoneNumber      Int?              @map("phone_number")
  identityCard     String?           @map("identity_card")
  federationNumber Int?              @map("federation_number")
  shirtSize        Int?              @map("shirt_size")
  shirt            ShirtSize?        @relation(fields: [shirtSize], references: [id])
  nationality      Int?
  postalCode       String?           @map("postal_code")
  status           ParticipantStatus @default(auto)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  raceParticipant  RaceParticipant[]

  @@map("participants")
}

enum CheckoutStatus {
  checkout
  pending
  confirmed
}

model RaceParticipant {
  id            String         @id @default(uuid())
  participantId String         @map("participant_id")
  participant   Participant    @relation(fields: [participantId], references: [id])
  raceId        String         @map("race_id")
  race          Race           @relation(fields: [raceId], references: [id])
  status        CheckoutStatus @default(checkout)
  displayOrder  Int            @default(autoincrement()) @map("display_order")
  bookingId     String         @map("booking_id")
  booking       Booking        @relation(fields: [bookingId], references: [id])
  teamId        String?        @map("team_id")
  team          EventTeam?     @relation(fields: [teamId], references: [id])
  eventId       String         @map("event_id")
  event         Event?         @relation(fields: [eventId], references: [id])
  bibNumber     Int?           @map("bib_number")
  price         Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([participantId, raceId])
  @@unique([eventId, bibNumber])
  @@map("race_participants")
}

// Booking represents the act of a specific user of registering 1+ participants in an event;
// It holds the state of the overall registration in the event
model Booking {
  id              String            @id @default(uuid())
  status          CheckoutStatus    @default(checkout)
  pin             Int
  eventId         String            @map("event_id")
  event           Event             @relation(fields: [eventId], references: [id])
  userId          String            @map("user_id")
  // This field will contain 'discountCode|value|fixed'
  // This way, even if the discount code values get updated, we'll know what discount was applied
  appliedDiscount String?           @map("applied_discount")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  raceParticipant RaceParticipant[]
  payment         Payment[]

  @@map("bookings")
}

enum PaymentStatus {
  requested
  pending
  submitted
  paid
  failed
  canceled
  expired
  // This should represent case when get-status fails
  // It will be used to display an handled error message
  fetchStatusFailed
}

enum PaymentMethod {
  CARD
  REFERENCE
  MBWAY
}

model Payment {
  id             String         @id
  method         PaymentMethod?
  status         PaymentStatus  @default(requested)
  amount         Int
  transactionId  String?        @unique @map("transaction_id")
  notificationId String?        @unique @map("notification_id")
  expiresAt      DateTime?      @map("expires_at")
  bookingId      String         @map("booking_id")
  booking        Booking        @relation(fields: [bookingId], references: [id])
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  mbReference    String?        @map("mb_reference")
  mbEntity       String?        @map("mb_entity")

  @@map("payments")
}

model PaymentNotification {
  id            String   @id
  transactionId String   @map("transaction_id")
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("payment_notifications")
}

model ShirtSize {
  id           Int           @id @default(autoincrement())
  name         Json
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  participants Participant[]

  @@map("shirt_size")
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organizer {
  id                String              @id
  name              String
  description       String
  logo              String
  email             String              @unique
  phoneNumber       Int?                @unique @map("phone_number")
  address           String
  postalCode        String              @map("postal_code")
  city              String
  commission        Int?
  taxNumber         Int                 @map("tax_number")
  userId            String              @map("user_id") @unique
  contactName       String              @map("contact_name")
  user              User                @relation(fields: [userId], references: [id])
  status            OrganizerStatus     @default(PENDING)
  typeId            Int                 @map("type_id")
  type              OrganizerType       @relation(fields: [typeId], references: [id])
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  DiscountCode      DiscountCode[]
  MailingList       MailingList[]

  @@map("organizers")
}

model OrganizerType {
    id              Int                 @id
    name            Json
    createdAt       DateTime            @default(now()) @map("created_at")
    updatedAt       DateTime            @updatedAt @map("updated_at")
    organizers      Organizer[]

    @@map("organizer_types")
}

enum DiscountCodeStatus {
  active
  deleted
  disabled
}

model DiscountCode {
  id          String              @id
  code        String              @db.VarChar(20)
  value       Int
  fixed       Boolean
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdById String              @map("created_by") @db.VarChar(20)
  organizer   Organizer           @relation(fields: [organizerId], references: [id])
  organizerId String              @map("organizer_id") @db.VarChar(20)
  status      DiscountCodeStatus  @default(active)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([code, organizerId])
  @@map("discount_codes")
}

// Saves email from users that want to receive news from certain organizers
model MailingList {
    email           String
    organizerId     String      @map("organizer_id")
    organizer       Organizer   @relation(fields: [organizerId], references: [id])
    createdAt       DateTime    @default(now()) @map("created_at")

    @@unique([email, organizerId])
    @@map("mailing_list")
}

model EventTeam {
    id                  String                  @id
    name                String
    eventId             String                  @map("event_id")
    event               Event                   @relation(fields: [eventId], references: [id])
    createdAt           DateTime                @default(now()) @map("created_at")
    updatedAt           DateTime                @updatedAt @map("updated_at")
    raceParticipants    RaceParticipant[]

    @@unique([name, eventId])
    @@map("event_teams")
}

model LatestBibNumber {
    eventId             String                  @map("event_id") @id
    bibNumber           Int                     @default(0) @map("bib_number")
    event               Event                   @relation(fields: [eventId], references: [id])
    createdAt           DateTime                @default(now()) @map("created_at")
    updatedAt           DateTime                @updatedAt @map("updated_at")

    @@map("latest_bib_number")
}
