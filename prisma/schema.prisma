// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Commands to know:
// `npx prisma generate` - update TypeScript definitions based on this schema
// `npx prisma db push` - push the schema changes to the database
// `npx prisma studio` - open the Studio, which allows you to edit the schema.
// `npx prisma migrate reset` - reset the migrations to the last version. This will reset the DB and run the seed script
// `npx prisma migrate dev --name <descriptive-name>` - generate a migration file for any changes you make to the schema (this will be committed).
// `npx prisma migrate dev --name <descriptive-name> --create-only` - generate migration script... example: npx prisma migrate dev --name login_with_password --create-only

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "interactiveTransactions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  ORGANIZER
}

model User {
  id        String          @id
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  email     String          @unique
  password  String?
  salt      String?
  lat       Float?
  lng       Float?
  location  String?
  name      String
  role      Role            @default(MEMBER)
  sessions  Session[]
  groups    Group[]
  favGroups FavoriteGroup[]
  events    Event[]

  @@map("users")
}

model Session {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  expirationDate DateTime @map("expiration_date")

  @@map("sessions")
}

model Sport {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  name      Json
  picture   String
  events    Event[]
  groups    Group[]

  @@map("sports")
}

enum Status {
  auto
  draft
  published
  unpublished
  deleted
}

model Event {
  id                 String     @id @default(uuid())
  name               String?
  sport              Sport?     @relation(fields: [sportId], references: [id])
  sportId            Int?       @map("sport_id")
  startAt            DateTime?  @map("start_at")
  endAt              DateTime?  @map("end_at")
  location           String?
  address            String?
  useExternalBooking Boolean    @default(false) @map("use_external_booking")
  externalBookingUrl String?    @map("external_booking_url")
  eventDescription   String?    @map("event_description")
  status             Status     @default(auto)
  image1             String?
  image2             String?
  image3             String?
  image4             String?
  image5             String?
  directions         String?
  createdBy          User       @relation(fields: [createdById], references: [id])
  createdById        String     @map("created_by")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  documents          Document[]
  perks              Perk[]
  races              Race[]

  @@map("events")
}

model Document {
  id        String   @id @default(uuid())
  path      String
  position  Int      @default(autoincrement())
  label     String?
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  status    Status   @default(auto)

  @@map("documents")
}

// Groups start
model Group {
  id            String      @id
  name          String?
  slug          String?     @unique
  sport         Sport?      @relation(fields: [sportId], references: [id])
  sportId       Int?        @map("sport_id")
  groupType     GroupType   @relation(fields: [groupTypeId], references: [id])
  groupTypeId   Int         @map("group_type_id")
  groupSpirit   GroupSpirit @relation(fields: [groupSpiritId], references: [id])
  groupSpiritId Int         @map("group_spirit_id")
  lat           Float
  lng           Float
  location      String?
  near          String?
  dayOfWeek     Int         @map("day_of_week")
  timeOfDay     Int         @map("time_of_day")
  whatsapp      String?
  image1        String?
  image2        String?
  image3        String?
  description   String?
  status        Status      @default(auto)
  createdAt     DateTime    @default(now()) @map("created_at")
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdById   String      @map("created_by")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  schedules     GroupSchedule[]

  favGroups FavoriteGroup[]
  @@map("groups")
}

model GroupType {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  name      Json
  groups    Group[]

  @@map("groups_type")
}

model GroupSpirit {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  name      Json
  groups    Group[]

  @@map("groups_spirit")
}

model FavoriteGroup {
  userId    String   @map("user_id")
  groupId   String   @map("group_id")
  user      User     @relation(fields: [userId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, groupId])
  @@map("favorite_groups")
}

model Perk {
  id            String          @id @default(uuid())
  name          String
  createdAt     DateTime        @default(now()) @map("created_at")

  isDefault     Boolean         @default(false) @map("is_default")
  isEnabled     Boolean         @default(false) @map("is_enabled")
  displayOrder  Int             @default(autoincrement()) @map("display_order")
  eventId       String          @map("event_id")
  event         Event           @relation(fields: [eventId], references: [id])

  @@map("perks")
}

model Race {
  id                String          @id @default(uuid())
  name              String
  distance          Float
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  startTime         Int             @map("start_time")
  elevationGain     Int             @map("elevation_gain")
  elevationLoss     Int?            @map("elevation_loss")
  price             Float
  priceEarlyBird    Float?          @map("price_early_bird")
  validUntil        DateTime?       @map("valid_until")
  raceDescription   String?         @map("race_description")
  displayOrder      Int             @default(autoincrement()) @map("display_order")
  status            Status          @default(auto)
  track             String?
  eventId           String          @map("event_id")
  event             Event           @relation(fields: [eventId], references: [id])

  @@map("races")
}

model GroupSchedule {
	id          String		@id @default(uuid())
	dayOfWeek   Int         @map("day_of_week")
  	timeOfDay   Int         @map("time_of_day")
  	groupId		String		@map("group_id")
    group       Group       @relation(fields: [groupId], references: [id])

  	@@map("group_schedule")
}
