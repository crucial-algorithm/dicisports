// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Commands to know:
// `npx prisma generate` - update TypeScript definitions based on this schema
// `npx prisma db push` - push the schema changes to the database
// `npx prisma studio` - open the Studio, which allows you to edit the schema.
// `npx prisma migrate reset` - reset the migrations to the last version. This will reset the DB and run the seed script
// `npx prisma migrate dev --name <descriptive-name>` - generate a migration file for any changes you make to the schema (this will be committed).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  ORGANIZER
}

model User {
  @@map("users")
  id           String     @id
  createdAt    DateTime   @default(now())   @map("created_at")
  updatedAt    DateTime   @updatedAt        @map("updated_at")
  email        String     @unique
  name         String
  role         Role       @default(MEMBER)
  sessions     Session[]
  groups       Group[]
}

model Session {
  @@map("sessions")
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())   @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  expirationDate DateTime @map("expiration_date")
}

model Sport {
  @@map("sports")
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())  @map("created_at")
  updatedAt  DateTime @updatedAt       @map("updated_at")
  name       Json
  events     Event[]
  groups     Group[]
}

enum Status {
    auto
    draft
    published
    unpublished
    deleted
}

model Event {
  @@map("events")
  id                    String     @id @default(uuid())
  name                  String?
  sport                 Sport?     @relation(fields: [sportId], references: [id])
  sportId               Int?       @map("sport_id")
  startAt               DateTime?  @map("start_at")
  endAt                 DateTime?  @map("end_at")
  location              String?
  address               String?
  useExternalBooking    Boolean    @default(false)   @map("use_external_booking")
  externalBookingUrl    String?    @map("external_booking_url")
  status                Status     @default(auto)
  createdAt             DateTime   @default(now())  @map("created_at")
  updatedAt             DateTime   @updatedAt       @map("updated_at")
  documents             Document[]
}

model Document {
  @@map("documents")
  id                    String    @id @default(uuid())
  key                   String
  position              Int
  label                 String?
  event                 Event     @relation(fields: [eventId], references: [id])
  eventId               String    @map("event_id")
  createdAt             DateTime  @default(now())  @map("created_at")
  updatedAt             DateTime  @updatedAt       @map("updated_at")
}


// Metting points start
model Group {
  @@map("groups")
  id                    String          @id
  name                  String?
  sport                 Sport?          @relation(fields: [sportId], references: [id])
  sportId               Int?            @map("sport_id")
  groupType             GroupType       @relation(fields: [groupTypeId], references: [id])
  groupTypeId           Int             @map("group_type_id")
  groupSpirit           GroupSpirit     @relation(fields: [groupSpiritId], references: [id])
  groupSpiritId         Int             @map("group_spirit_id")
  location              String?
  near                  String?
  dayOfWeek             Int             @map("day_of_week")
  timeOfDay             String          @map("time_of_day")
  whatsapp              String?
  image1                String?
  image2                String?
  image3                String?
  status                Status          @default(auto)
  createdAt             DateTime        @default(now()) @map("created_at")
  createdBy             User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById           String          @map("created_by")
  updatedAt             DateTime        @updatedAt  @map("updated_at")
}

model GroupType {
  @@map("groups_type")
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())  @map("created_at")
  updatedAt  DateTime @updatedAt       @map("updated_at")
  name       Json
  groups     Group[]
}

model GroupSpirit {
  @@map("groups_spirit")
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())  @map("created_at")
  updatedAt  DateTime @updatedAt       @map("updated_at")
  name       Json
  groups     Group[]
}
