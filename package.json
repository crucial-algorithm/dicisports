{
  "private": true,
  "name": "remix-app-template",
  "description": "",
  "license": "",
  "scripts": {
    "build": "npm run build:css && remix build",
    "dev": "concurrently \"npm run dev:css\" \"node -r dotenv/config node_modules/.bin/remix dev\"",
    "build:css": "npm run generate:css && npm run deploy:css",
    "dev:css": "npm run generate:css && npm run deploy:css -- --watch",
    "generate:css": "tailwindcss -o app/styles/tailwind.css",
    "deploy:css": "postcss styles/**/*.css --base styles --dir app/styles",
    "postinstall": "remix setup node",
    "start": "remix-serve build",
    "lint": "npm run lint:eslint",
    "lint:eslint": "eslint ./ --ext .tsx --ext .ts",
    "deploy:staging": "flyctl --app dicistg deploy .",
    "test:open": "npx cypress open",
    "test:run": "npx cypress run --browser chrome",
    "ci:build": "npm run build:css && npx prisma migrate reset --force && prisma db seed"
  },
  "prisma": {
    "seed": "node --require esbuild-register prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.178.0",
    "@aws-sdk/lib-storage": "3.179.0",
    "@fontsource/roboto": "4.5.1",
    "@headlessui/react": "1.7.11",
    "@heroicons/react": "2.0.12",
    "@mapbox/mapbox-gl-geocoder": "5.0.1",
    "@prisma/client": "4.10.1",
    "@radix-ui/react-dialog": "1.0.2",
    "@remix-run/node": "1.13.0",
    "@remix-run/react": "1.13.0",
    "@remix-run/serve": "1.13.0",
    "@tailwindcss/aspect-ratio": "^0.4.0",
    "@tailwindcss/forms": "^0.4.0",
    "@types/react-map-gl": "6.1.1",
    "ahooks": "3.7.5",
    "cloudinary": "1.27.1",
    "cloudinary-build-url": "^0.2.4",
    "clsx": "^1.1.1",
    "date-fns": "2.27.0",
    "exceljs": "4.3.0",
    "file-saver": "2.0.5",
    "file-type": "16.5.4",
    "framer-motion": "9.0.4",
    "i18next": "22.4.9",
    "i18next-browser-languagedetector": "7.0.1",
    "i18next-fs-backend": "2.1.1",
    "i18next-http-backend": "2.1.1",
    "lodash": "^4.17.21",
    "mapbox-gl": "2.15.0",
    "postcss-import": "^14.0.2",
    "primeicons": "6.0.1",
    "primereact": "10.0.2",
    "quill": "1.3.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-dropzone": "11.4.2",
    "react-i18next": "12.1.5",
    "react-intersection-observer": "9.5.2",
    "react-pdf": "6.2.2",
