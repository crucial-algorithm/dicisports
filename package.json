{
  "private": true,
  "name": "remix-app-template",
  "description": "",
  "license": "",
  "scripts": {
    "build": "npm run build:css && remix build",
    "dev": "concurrently \"npm run dev:css\" \"node -r dotenv/config node_modules/.bin/remix dev\"",
    "build:css": "npm run generate:css && npm run deploy:css",
    "dev:css": "npm run generate:css && npm run deploy:css -- --watch",
    "generate:css": "tailwindcss -o ./styles/tailwind.css",
    "deploy:css": "postcss styles/**/*.css --base styles --dir app/styles",
    "postinstall": "remix setup node",
    "start": "remix-serve build",
    "lint": "npm run lint:eslint",
    "lint:eslint": "eslint ./ --ext .tsx --ext .ts",
    "deploy:staging": "flyctl --app dicistg deploy .",
    "test:open": "npx cypress open",
    "test:run": "npx cypress run"
  },
  "prisma": {
    "seed": "node --require esbuild-register prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.178.0",
    "@aws-sdk/lib-storage": "3.179.0",
    "@emotion/react": "11.7.1",
    "@emotion/server": "11.4.0",
    "@emotion/styled": "11.6.0",
    "@fontsource/roboto": "4.5.1",
    "@headlessui/react": "^1.4.2",
    "@heroicons/react": "^1.0.5",
    "@mapbox/mapbox-gl-geocoder": "5.0.1",
    "@prisma/client": "3.13.0",
    "@reach/auto-id": "^0.16.0",
    "@reach/dialog": "^0.16.2",
    "@reach/menu-button": "^0.16.2",
    "@remix-run/node": "1.6.5",
    "@remix-run/react": "1.6.5",
    "@remix-run/serve": "1.6.5",
    "@tailwindcss/aspect-ratio": "^0.4.0",
    "@tailwindcss/forms": "^0.4.0",
    "@types/react-map-gl": "6.1.1",
    "cloudinary": "1.27.1",
    "cloudinary-build-url": "^0.2.4",
    "clsx": "^1.1.1",
    "date-fns": "2.27.0",
    "framer-motion": "^5.6.0",
    "i18next": "21.8.14",
    "i18next-browser-languagedetector": "6.1.4",
    "i18next-fs-backend": "1.1.4",
    "i18next-http-backend": "1.4.1",
    "lodash": "^4.17.21",
    "mapbox-gl": "2.6.1",
    "postcss-import": "^14.0.2",
    "react": "17.0.2",
    "react-copy-to-clipboard": "5.0.4",
    "react-dom": "17.0.2",
    "react-dropzone": "11.4.2",
    "react-i18next": "11.18.1",
    "react-responsive-carousel": "3.2.23",
    "react-select": "^5.2.2",
    "remix": "1.6.5",
    "remix-i18next": "4.1.1",
    "spin-delay": "^1.1.0",
    "zod": "^3.11.6"
  },
  "devDependencies": {
    "@cld-apis/types": "0.1.6",
    "@remix-run/dev": "1.6.5",
    "@remix-run/eslint-config": "1.6.5",
    "@tailwindcss/line-clamp": "0.4.2",
    "@tailwindcss/typography": "0.5.2",
    "@types/i18next-fs-backend": "1.1.2",
    "@types/lodash": "^4.14.178",
    "@types/mapbox__mapbox-gl-geocoder": "4.7.3",
    "@types/react": "17.0.24",
    "@types/react-copy-to-clipboard": "5.0.2",
    "@types/react-dom": "17.0.9",
    "autoprefixer": "^10.4.2",
    "concurrently": "^7.0.0",
    "cypress": "10.10.0",
    "dotenv": "10.0.0",
    "esbuild-register": "3.2.1",
    "eslint": "8.5.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-import-resolver-typescript": "3.3.0",
    "eslint-plugin-cypress": "2.12.1",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-prettier": "4.0.0",
    "postcss": "^8.4.5",
    "postcss-cli": "^9.1.0",
    "prettier": "2.5.1",
    "prisma": "3.13.0",
    "tailwindcss": "3.0.9",
    "typescript": "4.4.4"
  },
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false
}
