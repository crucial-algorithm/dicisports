{
  "private": true,
  "name": "dicisports",
  "description": "",
  "type": "module",
  "license": "",
  "scripts": {
    "build": "npm run build:css && remix build",
    "dev-old": "concurrently \"npx tsc -w --pretty --skipLibCheck --noEmit -p tsconfig.check.json\" \"node -r dotenv/config node_modules/.bin/remix dev\"",
    "dev": "remix vite:dev --host",
    "build-vite": "remix vite:build",
    "start-vite": "remix-serve ./build/server/",
    "dev-slim": "concurrently \"node -r dotenv/config node_modules/.bin/remix dev\"",
    "postinstall": "remix setup node",
    "start": "remix-serve build",
    "lint": "npm run lint:eslint",
    "lint:eslint": "eslint ./ --ext .tsx --ext .ts",
    "deploy:staging": "flyctl --app dicistg deploy .",
    "test:open": "npx cypress open",
    "test:run": "NODE_NO_WARNINGS=1 npx cypress run --browser chrome",
    "ci:build": "npx prisma migrate reset --force && prisma db seed",
    "typecheck": "tsc --skipLibCheck --noEmit -p tsconfig.check.json"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
