{
  "private": true,
  "name": "remix-app-template",
  "description": "",
  "license": "",
  "scripts": {
    "build": "npm run build:css && remix build",
    "dev": "concurrently \"npm run dev:css\" \"node -r dotenv/config node_modules/.bin/remix dev\"",
    "build:css": "tailwindcss -o ./app/styles/tailwind.css",
    "dev:css": "postcss styles/**/*.css --base styles --dir app/styles --watch",
    "postinstall": "remix setup node",
    "start": "remix-serve build",
    "lint": "yarn lint:eslint",
    "lint:eslint": "eslint ./ --ext .tsx --ext .ts"
  },
  "prisma": {
    "seed": "node --require esbuild-register prisma/seed.ts"
  },
  "dependencies": {
    "@emotion/react": "11.7.1",
    "@emotion/server": "11.4.0",
    "@emotion/styled": "11.6.0",
    "@fontsource/roboto": "4.5.1",
    "@headlessui/react": "^1.4.2",
    "@heroicons/react": "^1.0.5",
    "@prisma/client": "3.7.0",
    "@reach/auto-id": "^0.16.0",
    "@reach/dialog": "^0.16.2",
    "@reach/menu-button": "^0.16.2",
    "@remix-run/react": "1.1.1",
    "@remix-run/serve": "1.1.1",
    "@tailwindcss/aspect-ratio": "^0.4.0",
    "@tailwindcss/forms": "^0.4.0",
    "@tailwindcss/typography": "^0.5.0",
    "@types/react-map-gl": "6.1.1",
    "cloudinary": "1.27.1",
    "cloudinary-build-url": "^0.2.4",
    "clsx": "^1.1.1",
    "date-fns": "2.27.0",
    "framer-motion": "^5.6.0",
    "i18next": "21.6.4",
    "lodash": "^4.17.21",
    "mapbox-gl": "2.6.1",
    "postcss-import": "^14.0.2",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-dropzone": "11.4.2",
    "react-i18next": "11.15.2",
    "react-select": "^5.2.2",
    "remix": "1.1.1",
    "remix-i18next": "2.1.4",
    "spin-delay": "^1.1.0",
    "zod": "^3.11.6"
  },
  "devDependencies": {
    "@remix-run/dev": "1.1.1",
    "@remix-run/eslint-config": "1.1.1",
    "@types/lodash": "^4.14.178",
    "@types/react": "17.0.24",
    "@types/react-dom": "17.0.9",
    "autoprefixer": "^10.4.2",
    "concurrently": "^7.0.0",
    "dotenv": "10.0.0",
    "esbuild-register": "3.2.1",
    "eslint": "8.5.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-prettier": "4.0.0",
    "postcss": "^8.4.5",
    "postcss-cli": "^9.1.0",
    "prettier": "2.5.1",
    "prisma": "3.7.0",
    "tailwindcss": "3.0.9",
    "typescript": "4.4.4"
  },
  "engines": {
    "node": ">=14"
  },
  "sideEffects": false
}
